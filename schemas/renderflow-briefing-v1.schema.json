{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/renderflow/schemas/renderflow-briefing-v1.schema.json",
  "title": "Local source-bound briefing v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "renderflow.briefing/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "as_of": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rights": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "script_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/review"
        },
        {
          "type": "null"
        }
      ]
    },
    "narration": {
      "anyOf": [
        {
          "$ref": "#/$defs/narration"
        },
        {
          "type": "null"
        }
      ]
    },
    "feed": {
      "anyOf": [
        {
          "$ref": "#/$defs/feed"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "language",
    "as_of",
    "rights",
    "sources",
    "chapters"
  ],
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "sha256",
        "reference"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "source_id",
        "start_line",
        "end_line"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "canonical_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "rights": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/review"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "revision",
        "rights"
      ]
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "start_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "sources"
      ]
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "script_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin": {
          "enum": [
            "human_recording",
            "supplied_synthetic"
          ]
        },
        "voice_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "consent_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "provider_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "model_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "rights": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/review"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "script_sha256",
        "origin",
        "voice_reference",
        "consent_reference",
        "rights"
      ]
    },
    "feed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "site_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "episode_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "narration_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      },
      "required": [
        "title",
        "description",
        "site_url",
        "episode_url"
      ]
    }
  },
  "$comment": "Runtime cross-checks IDs, source line ranges, exact hashes/review bindings, strict relative paths, URLs, clocks and PCM16 WAV. String maxima are UTF-8 byte limits at runtime. Declarations do not authenticate approval; public publication never occurs here."
}
