{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/renderflow/schemas/renderflow-presentation-v1.schema.json",
  "title": "Renderflow renderer-neutral presentation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "language", "source", "as_of", "rights", "review_state", "theme", "transition", "slides"],
  "properties": {
    "schema_version": {"const": "renderflow.presentation/v1"},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]+)*$", "maxLength": 64},
    "source": {"$ref": "#/$defs/source"},
    "as_of": {"type": "string", "minLength": 1, "maxLength": 128},
    "rights": {"type": "string", "minLength": 1, "maxLength": 4096},
    "review_state": {"enum": ["draft", "reviewed"], "description": "An author declaration, never inferred approval."},
    "theme": {"enum": ["paper", "night"]},
    "transition": {"const": "none"},
    "slides": {"type": "array", "minItems": 1, "maxItems": 300, "items": {"$ref": "#/$defs/slide"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "url": {"type": "string", "minLength": 8, "maxLength": 4096, "pattern": "^https?://"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "path", "sha256"],
      "properties": {
        "repository": {"$ref": "#/$defs/url"},
        "revision": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false, "required": ["label", "url"],
      "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 1024}, "url": {"$ref": "#/$defs/url"}}
    },
    "image": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "alt", "rights"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/digest"},
        "alt": {"type": "string", "minLength": 1, "maxLength": 4096},
        "caption": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "rights": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "slide": {
      "type": "object", "additionalProperties": false, "required": ["id", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "section": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "paragraphs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 16384}},
        "bullets": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 16384}},
        "images": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/image"}},
        "citations": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/citation"}},
        "speaker_notes": {"type": ["string", "null"], "minLength": 1, "maxLength": 32768}
      }
    }
  },
  "$comment": "The Rust reader additionally enforces UTF-8 byte, aggregate, path, text-control, image and semantic bounds. Schema character limits do not replace those runtime checks. Schema execution remains deferred."
}
