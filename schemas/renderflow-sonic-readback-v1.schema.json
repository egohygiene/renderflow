{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "renderflow.sonic-readback/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_sha256",
    "intent_sha256",
    "bundle_state",
    "file_count",
    "source_state",
    "provider_state",
    "review_state",
    "runtime_qualified",
    "publication_approval"
  ],
  "properties": {
    "schema_version": {
      "const": "renderflow.sonic-readback/v1"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bundle_state": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "file_count": {
      "const": 8
    },
    "source_state": {
      "enum": [
        "current",
        "stale",
        "unavailable",
        "unavailable_or_changed",
        "not_supplied"
      ]
    },
    "provider_state": {
      "const": "not_reobserved; retained declarations only"
    },
    "review_state": {
      "const": "candidate"
    },
    "runtime_qualified": {
      "const": false
    },
    "publication_approval": {
      "const": "not_granted"
    }
  }
}
