{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "renderflow.sonic-description/v1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_dna_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "deterministic_evidence_render",
        "model_interpretation_of_structured_evidence"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "sections",
        "uncertainty",
        "review_required"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "evidence_ids"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "text",
              "evidence_ids"
            ],
            "properties": {
              "topic": {
                "enum": [
                  "technical",
                  "rhythm",
                  "harmony",
                  "timbre",
                  "vocal",
                  "arrangement",
                  "mix",
                  "lyrics",
                  "other"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        "uncertainty": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "review_required": {
          "const": true
        }
      }
    },
    "input_modality": {
      "const": "structured_evidence"
    },
    "review_state": {
      "const": "candidate"
    },
    "human_review_required": {
      "const": true
    },
    "grounding_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "source_dna_sha256",
    "mode",
    "candidate",
    "input_modality",
    "review_state",
    "human_review_required",
    "grounding_scope"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/renderflow/schemas/renderflow-sonic-description-v1.schema.json",
  "title": "Evidence-bound audio description candidate v1"
}
