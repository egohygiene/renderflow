    "speechPolicy": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"saved_results": {"const": "reuse_if_available"}}, "required": ["saved_results"]},
        "then": {"properties": {"recovery": {"type": "null"}}}
      }],
      "required": [
        "source_sha256",
        "provider",
        "model"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {
          "$ref": "#/$defs/speechTool"
        },
        "model": {
          "$ref": "#/$defs/speechModel"
        },
        "options": {
