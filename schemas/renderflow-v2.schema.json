      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Absolute local file path without parent traversal or control characters; interpreted on the execution host."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "speechAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_index",
        "ffprobe",
        "ffmpeg"
