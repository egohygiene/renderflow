{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/renderflow/schemas/renderflow-publication-rgb-v1.schema.json",
  "title": "Explicit composition preview to device RGB preparation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_profile",
    "source_sha256",
    "raster_plan_sha256",
    "output_sha256",
    "rgb_samples_sha256",
    "output_bytes",
    "width_px",
    "height_px",
    "source_dpi",
    "color_policy",
    "fidelity",
    "losses",
    "review_required",
    "runtime_qualified"
  ],
  "properties": {
    "schema_version": {
      "const": "renderflow.publication-rgb/v1"
    },
    "provider_profile": {
      "const": "renderflow.publication-rgb/v1;png=0.18.1;rgb8;compression=fast;filter=sub;metadata=none;alpha=opaque-only"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raster_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rgb_samples_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "width_px": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "height_px": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "source_dpi": {
      "type": "integer",
      "minimum": 36,
      "maximum": 600
    },
    "color_policy": {
      "const": "assumed_srgb_samples_to_device_rgb_no_conversion"
    },
    "fidelity": {
      "const": "partial"
    },
    "losses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_required": {
      "const": true
    },
    "runtime_qualified": {
      "const": false
    }
  }
}
