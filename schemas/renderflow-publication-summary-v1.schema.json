{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/renderflow/schemas/renderflow-publication-summary-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "renderflow.publication-summary/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "ranges",
          "approved_for_ai",
          "approval_reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "authored_script",
              "transcript",
              "text_companion"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ranges": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "approved_for_ai": {
            "type": "boolean"
          },
          "approval_reference": {
            "type": "string",
            "maxLength": 1024
          },
          "privacy_approved_for_remote": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
