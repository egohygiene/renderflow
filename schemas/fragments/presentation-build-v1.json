{
  "$comment": "Authored v2 presentation admission fragment. No schema generator or validator was executed. Native/provider/path/aggregate bounds remain Rust-owned.",
  "$defs": {
    "presentationBuildPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "node",
                "installation_root",
                "installation_sha256",
                "timeout_seconds"
              ],
              "properties": {
                "schema_version": {
                  "const": "renderflow.slidev-provider/v1"
                },
                "node": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "version"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  }
                },
                "installation_root": {
                  "type": "string",
                  "minLength": 1
                },
                "installation_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "browser": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256",
                        "version"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1800
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "include_speaker_notes": {
          "type": "boolean",
          "default": false
        },
        "allow_unqualified": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "presentationSource": {
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "presentation"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "null"
        },
        "members": {
          "maxItems": 0
        },
        "sha256": {
          "type": "null"
        },
        "geometry": {
          "type": "null"
        },
        "format": {
          "type": "null"
        },
        "media_type": {
          "type": "null"
        },
        "role": {
          "type": "null"
        },
        "detect": {
          "const": true
        },
        "immutable": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sources": {
            "contains": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "presentation"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/$defs/presentationSource"
            }
          },
          "targets": {
            "properties": {
              "exact": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "required": [
                    "format"
                  ],
                  "properties": {
                    "format": {
                      "enum": [
                        "presentation_source",
                        "presentation_web",
                        "pdf"
                      ]
                    },
                    "requirement": {
                      "const": "required"
                    },
                    "options": {
                      "maxProperties": 0
                    },
                    "id": {
                      "type": "null"
                    },
                    "role": {
                      "type": "null"
                    },
                    "family": {
                      "type": "null"
                    },
                    "capability": {
                      "type": "null"
                    },
                    "transform": {
                      "type": "null"
                    },
                    "provider": {
                      "type": "null"
                    },
                    "variant": {
                      "type": "null"
                    },
                    "preset": {
                      "type": "null"
                    },
                    "template": {
                      "type": "null"
                    }
                  }
                }
              },
              "profiles": {
                "maxItems": 0
              },
              "all_reachable": {
                "const": false
              },
              "include": {
                "$ref": "#/$defs/compositionEmptySelectors"
              },
              "exclude": {
                "$ref": "#/$defs/compositionEmptySelectors"
              },
              "intermediates": {
                "const": "cache_only"
              }
            }
          },
          "execution": {
            "properties": {
              "presentation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/presentationBuildPolicy"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "composition": {
                "type": "null"
              },
              "lyrics": {
                "type": "null"
              },
              "speech": {
                "type": "null"
              },
              "subtitles": {
                "type": "null"
              },
              "screenplay": {
                "type": "null"
              },
              "screenplay_body": {
                "type": "null"
              },
              "screenplay_pdf": {
                "type": "null"
              },
              "screenplay_recovery": {
                "type": "null"
              },
              "print_pdf_interior": {
                "type": "null"
              },
              "fixed_layout_epub": {
                "type": "null"
              },
              "publication_policy": {
                "type": "null"
              },
              "redaction_policy": {
                "type": "null"
              },
              "hygiene_policy": {
                "type": "null"
              },
              "retry_policy": {
                "type": "null"
              },
              "timeout_policy": {
                "type": "null"
              },
              "minimum_fidelity": {
                "type": "null"
              },
              "max_parallel": {
                "const": 1
              },
              "optimization": {
                "const": "balanced"
              },
              "network": {
                "const": "deny"
              },
              "ai": {
                "const": "deny"
              },
              "requirements": {
                "properties": {
                  "deterministic": {
                    "const": false
                  }
                }
              }
            },
            "$comment": "Rust admission additionally rejects every non-default unsupported execution field; local/offline intent does not establish OS isolation."
          },
          "profiles": {
            "maxProperties": 0
          },
          "variables": {
            "maxProperties": 0
          },
          "hygiene": {
            "maxProperties": 0
          },
          "publication": {
            "type": "null"
          },
          "transforms": {
            "type": "null"
          },
          "output": {
            "properties": {
              "collision": {
                "const": "error"
              },
              "naming_template": {
                "const": "{source.id}/{target.role}.{ext}"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "execution": {
            "properties": {
              "presentation": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
