{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/renderflow/schemas/renderflow-summary-candidate-v1.schema.json",
  "description": "Reference/digest consistency is additional code validation; schema does not establish factual correctness or source/human authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "recipe_sha256",
    "body",
    "sources",
    "slices",
    "processing",
    "state",
    "review_required",
    "grounding",
    "coverage_note",
    "reference_validator"
  ],
  "properties": {
    "schema_version": {
      "const": "renderflow.summary-candidate/v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^summary-[a-f0-9]{64}$"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "body": {
      "$ref": "renderflow-summary-body-v1.schema.json"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "artifact_id",
          "sha256",
          "size_bytes",
          "selected_bytes",
          "unselected_bytes",
          "approved_for_ai",
          "privacy_approved_for_remote",
          "approval_reference"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "selected_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "unselected_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "approved_for_ai": {
            "const": true
          },
          "privacy_approved_for_remote": {
            "type": "boolean"
          },
          "approval_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_id",
          "artifact_id",
          "source_sha256",
          "start",
          "end",
          "text_sha256",
          "text"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^evidence-[a-f0-9]{64}$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_sha256",
        "skill_sha256",
        "input_sha256",
        "output_schema_sha256",
        "settings_sha256",
        "hygiene_sha256",
        "cache_identity",
        "skill_id",
        "skill_version",
        "model"
      ],
      "properties": {
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "skill_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "settings_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hygiene_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cache_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "skill_id": {
          "const": "skill.publication.summary"
        },
        "skill_version": {
          "const": "1.0.0"
        },
        "model": {
          "type": "object",
          "description": "Unchanged shared AiIdentityEvidence; requested and server-reported identity are not native weight attestation."
        }
      }
    },
    "state": {
      "const": "candidate"
    },
    "review_required": {
      "const": true
    },
    "grounding": {
      "const": "references_checked_semantics_unverified"
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "reference_validator": {
      "const": "validator.summary.references/v1"
    }
  }
}
