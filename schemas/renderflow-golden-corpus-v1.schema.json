{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/renderflow/schemas/renderflow-golden-corpus-v1.schema.json",
  "title": "Renderflow golden artifact corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_version",
    "license",
    "redistribution",
    "fixtures",
    "collections",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "renderflow.golden-corpus/v1"
    },
    "corpus_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "license": {
      "const": "CC0-1.0"
    },
    "redistribution": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/documentPack"
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "encoding",
        "payload",
        "expected_media_type",
        "family",
        "expected_outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fixture\\.[a-z0-9.-]+$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "enum": [
            "utf8",
            "hex",
            "file"
          ]
        },
        "payload": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_format": {
          "type": "string",
          "minLength": 1
        },
        "expected_media_type": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcome": {
          "enum": [
            "accepted",
            "conflict",
            "rejected"
          ]
        },
        "expected_diagnostic": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy": {
          "$ref": "#/$defs/taxonomy"
        },
        "extraction_limits": {
          "$ref": "#/$defs/extractionLimits"
        },
        "expected_discovered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": [
              "sha256"
            ],
            "properties": {
              "payload": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fixture\\.collection\\.[a-z0-9.-]+$"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "fixtures"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "tier": {
          "enum": [
            "fast",
            "tool_backed",
            "maximal"
          ]
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expected_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/expectedArtifact"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assertion_scope": {
          "enum": [
            "synthetic_contract",
            "intake",
            "native_output",
            "availability",
            "inventory"
          ]
        },
        "pack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "case_id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "case_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "expectedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "role",
        "format",
        "media_type",
        "provider_id",
        "oracle_path",
        "source_ids"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "provider_id": {
          "type": "string",
          "pattern": "^tool\\.[a-z0-9.-]+$"
        },
        "provider_version": {
          "type": "string",
          "minLength": 1
        },
        "oracle_path": {
          "type": "string",
          "pattern": "^expected/(?:[a-z0-9_-]+/)*[a-z0-9_-]+(?:\\.[a-z0-9_-]+)+$"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^fixture\\.[a-z0-9.-]+$"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_fixtures",
        "max_fixture_bytes",
        "max_total_source_bytes",
        "cooperative_seconds"
      ],
      "properties": {
        "max_fixtures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_fixture_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_total_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "cooperative_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "assertion_scope",
        "construction",
        "seed",
        "generator",
        "residual"
      ],
      "properties": {
        "class": {
          "enum": [
            "valid",
            "boundary",
            "malformed",
            "unsupported",
            "resource_stress"
          ]
        },
        "assertion_scope": {
          "const": "intake"
        },
        "construction": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "const": 0
        },
        "generator": {
          "enum": [
            "renderflow.golden.inline/v1",
            "renderflow.golden.file/v1"
          ]
        },
        "residual": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extractionLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_depth",
        "max_artifacts",
        "max_extracted_bytes",
        "max_expansion_ratio"
      ],
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_artifacts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_extracted_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_expansion_ratio": {
          "type": "number",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_path",
        "catalog_sha256",
        "scopes"
      ],
      "properties": {
        "catalog_path": {
          "const": "crates/renderflow-core/data/creative-routes.json"
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "category",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "input_family",
                  "failure_class",
                  "local_capability"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "packPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "packOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "format",
        "media_type",
        "schema",
        "validator"
      ],
      "properties": {
        "role": {
          "const": "page"
        },
        "format": {
          "enum": [
            "svg",
            "html",
            "transcript_json",
            "png",
            "pdf"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "validator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "exercise",
        "parameters",
        "limits",
        "outputs",
        "negative_cases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "fast",
            "maximal"
          ]
        },
        "exercise": {
          "enum": [
            "execute",
            "plan",
            "opt_in_execute"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "interior_pages",
            "cover_pages",
            "width_mm",
            "height_mm",
            "dpi"
          ],
          "properties": {
            "seed": {
              "const": 0
            },
            "interior_pages": {
              "type": "integer",
              "minimum": 2,
              "maximum": 44,
              "multipleOf": 2
            },
            "cover_pages": {
              "const": 2
            },
            "width_mm": {
              "const": 100
            },
            "height_mm": {
              "const": 140
            },
            "dpi": {
              "const": 127
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_files",
            "max_source_bytes",
            "max_output_bytes",
            "cooperative_seconds"
          ],
          "properties": {
            "max_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "max_source_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 134217728
            },
            "cooperative_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packOutput"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "negative_cases": {
          "type": "array",
          "items": {
            "enum": [
              "stale_content",
              "unreviewed_content",
              "digest_mismatch",
              "missing_asset",
              "missing_font",
              "unsupported_schema",
              "wrong_order",
              "wrong_count",
              "wrong_geometry",
              "missing_accessibility",
              "pre_cancel",
              "unavailable_interchange",
              "missing_output",
              "corrupt_output"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "documentPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "version",
        "document_type",
        "source_fixture",
        "generator",
        "toolchain",
        "profile",
        "assets",
        "rights",
        "license",
        "provenance",
        "required_capabilities",
        "optional_capabilities",
        "cases",
        "unavailable_mappings",
        "recipe_dependencies"
      ],
      "properties": {
        "schema_version": {
          "const": "renderflow.document-fixture-pack/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "1.1.0"
        },
        "document_type": {
          "const": "comic"
        },
        "source_fixture": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "$ref": "#/$defs/packPin"
        },
        "toolchain": {
          "$ref": "#/$defs/packPin"
        },
        "profile": {
          "const": "renderflow.layered-composition/v5"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packPin"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rights": {
          "$ref": "#/$defs/packPin"
        },
        "license": {
          "const": "CC0-1.0"
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "optional_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packCase"
          },
          "minItems": 1
        },
        "unavailable_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "format",
              "reason"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "recipe_dependencies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/packPin"
          }
        }
      }
    }
  }
}
