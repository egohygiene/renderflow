{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderflow.dev/schemas/renderflow-ebook-evidence-v1.schema.json",
  "title": "Renderflow e-book inspection evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "source_sha256",
    "variant",
    "valid",
    "layout",
    "xhtml_documents",
    "spine_items",
    "navigation",
    "page_list",
    "metadata",
    "accessibility",
    "retailer_acceptance",
    "diagnostics"
  ],
  "properties": {
    "schema": { "const": "renderflow.ebook-evidence/v1" },
    "source": { "type": "string" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "variant": { "enum": ["epub", "kepub"] },
    "valid": { "type": "boolean" },
    "epub_version": { "type": ["string", "null"] },
    "package_document": { "type": ["string", "null"] },
    "layout": { "enum": ["reflowable", "pre_paginated", "mixed", "unknown"] },
    "xhtml_documents": { "type": "integer", "minimum": 0 },
    "spine_items": { "type": "integer", "minimum": 0 },
    "navigation": { "type": "boolean" },
    "page_list": { "type": "boolean" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "creator", "language", "identifier", "rights"],
      "properties": {
        "title": { "type": "boolean" },
        "creator": { "type": "boolean" },
        "language": { "type": "boolean" },
        "identifier": { "type": "boolean" },
        "rights": { "type": "boolean" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_modes", "accessibility_features", "accessibility_hazards", "accessibility_summary", "conforms_to"],
      "properties": {
        "access_modes": { "type": "integer", "minimum": 0 },
        "accessibility_features": { "type": "integer", "minimum": 0 },
        "accessibility_hazards": { "type": "integer", "minimum": 0 },
        "accessibility_summary": { "type": "boolean" },
        "conforms_to": { "type": "boolean" }
      }
    },
    "retailer_acceptance": { "const": "requires_provider_profile" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "epubcheck": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider_id", "available"],
      "properties": {
        "provider_id": { "const": "tool.epubcheck" },
        "available": { "type": "boolean" },
        "version": { "type": ["string", "null"] },
        "passed": { "type": ["boolean", "null"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "report": {},
        "diagnostic": { "type": ["string", "null"] },
        "status": { "enum": ["passed", "invalid", "unavailable", "provider_error"] },
        "executable": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "exit_code": { "type": "integer" }
      }
    },
    "fixed_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pages"],
      "properties": {
        "status": { "enum": ["validated", "invalid", "unsupported"] },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "image", "image_sha256", "width_px", "height_px"],
            "properties": {
              "page": { "type": "string" },
              "image": { "type": "string" },
              "image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "width_px": { "type": "integer", "minimum": 1 },
              "height_px": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "run_id", "diagnostic"],
      "properties": {
        "status": { "enum": ["verified", "stale", "corrupt"] },
        "run_id": { "type": ["string", "null"] },
        "diagnostic": { "type": ["string", "null"] }
      }
    }
  }
}
