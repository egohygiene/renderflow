{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/renderflow/schemas/renderflow-composition-evidence-v3.schema.json",
  "title": "Renderflow scoped composition plan and run evidence v3",
  "description": "Candidate evidence envelopes for measured layered composition and explicit bounded PNG rasterization. Glyph metrics, conservative outlines and raster settings record the adopted provider policy; runtime, visual fidelity, color conversion and creative qualification remain separate. Historical v1 and v2 schemas remain available.",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/run"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run:sha256:[a-f0-9]{64}$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^target-[a-f0-9]{64}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^artifact:sha256:[a-f0-9]{64}$"
    },
    "output": {
      "enum": [
        "svg",
        "html",
        "transcript_json",
        "transcript_text",
        "png",
        "pdf",
        "ora",
        "psd",
        "idml"
      ]
    },
    "localeSelector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "exact"
            },
            "locale": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "locale"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "subset"
            },
            "locales": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "mode",
            "locales"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "all_declared"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      ],
      "description": "The SDK deduplicates selected locale values. Unknown locale values remain explicit blocked branches, including malformed or empty exact values; no fallback is inferred. Successful planning requires 1 to 64 distinct selected locales."
    },
    "request": {
      "type": "object",
      "properties": {
        "locales": {
          "$ref": "#/$defs/localeSelector"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/output"
          },
          "description": "The scoped planner deduplicates output values; output availability is recorded per branch."
        },
        "raster": {
          "$ref": "#/$defs/rasterSettings"
        }
      },
      "required": [
        "locales",
        "targets"
      ],
      "additionalProperties": false,
      "description": "Scoped locale/output selection. raster may be omitted in incoming JSON for backward-compatible deterministic defaults; emitted plans include its requested value. Effective normalized raster settings affect PNG branch identity only."
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "layer_id": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "inputEvidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "manifest",
            "asset",
            "content",
            "original",
            "font_registry",
            "font",
            "font_license_observed"
          ]
        },
        "id": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "id",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false,
      "description": "Identity of captured immutable input bytes. Font-license hashes are observed because font-registry v1 has no declared license-file digest. Sharing input digests does not by itself establish an executed cache hit."
    },
    "branchPlan": {
      "type": "object",
      "properties": {
        "target_id": {
          "$ref": "#/$defs/targetId"
        },
        "locale": {
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "state": {
          "enum": [
            "planned",
            "blocked",
            "unavailable"
          ]
        },
        "content_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_key": {
          "$ref": "#/$defs/sha256"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "typography": {
          "anyOf": [
            {
              "$ref": "#/$defs/typographyReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "raster": {
          "anyOf": [
            {
              "$ref": "#/$defs/rasterPlan"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target_id",
        "locale",
        "output",
        "state",
        "content_revision",
        "content_sha256",
        "cache_key",
        "diagnostics",
        "typography",
        "raster"
      ],
      "additionalProperties": false,
      "description": "A selected locale/output branch. SVG, HTML and PNG retain the same per-locale measured typography when captured content exists. PNG alone retains its effective raster plan when settings and dimensions are valid; other outputs retain null. Missing captured content or invalid raster settings produce blocked branches. A plan does not establish an output file.",
      "allOf": [
        {
          "if": {
            "properties": {
              "output": {
                "not": {
                  "enum": [
                    "svg",
                    "html",
                    "png"
                  ]
                }
              }
            },
            "required": [
              "output"
            ]
          },
          "then": {
            "properties": {
              "typography": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "output": {
                "not": {
                  "const": "png"
                }
              }
            },
            "required": [
              "output"
            ]
          },
          "then": {
            "properties": {
              "raster": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "output": {
                "const": "png"
              },
              "state": {
                "const": "planned"
              }
            },
            "required": [
              "output",
              "state"
            ]
          },
          "then": {
            "properties": {
              "raster": {
                "$ref": "#/$defs/rasterPlan"
              },
              "typography": {
                "$ref": "#/$defs/typographyReport"
              }
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "renderflow.composition-plan/v3"
        },
        "profile": {
          "const": "renderflow.layered-composition/v3"
        },
        "renderflow_version": {
          "type": "string",
          "minLength": 1
        },
        "composition_id": {
          "type": "string",
          "minLength": 1
        },
        "composition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_locale": {
          "type": "string",
          "minLength": 1
        },
        "default_locale": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputEvidence"
          }
        },
        "font_resolution": {
          "type": [
            "object",
            "null"
          ],
          "description": "Path-independent registry resolution evidence, or null when registry resolution fails. This records declared defaults and licensing status; a visual branch's typography report identifies the actual measured whole-layer fallback selection."
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 576,
          "items": {
            "$ref": "#/$defs/branchPlan"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "runtime_qualified": {
          "const": false
        },
        "review_required": {
          "const": true
        },
        "deterministic_serialization": {
          "const": true
        },
        "visual_determinism_qualified": {
          "const": false
        }
      },
      "required": [
        "schema",
        "profile",
        "renderflow_version",
        "composition_id",
        "composition_sha256",
        "source_locale",
        "default_locale",
        "request",
        "inputs",
        "font_resolution",
        "branches",
        "diagnostics",
        "runtime_qualified",
        "review_required",
        "deterministic_serialization",
        "visual_determinism_qualified"
      ],
      "additionalProperties": false,
      "description": "Scoped composition plan from captured inputs with measured visual-branch typography. The plan does not mutate the general format-keyed artifact forest and contains no publication assertion. Its cache keys commit the serialized typography report digest, renderer identity, source inputs and profile. A composition.typography.plan_budget error can reject an oversized visual request before publication; selecting fewer locales per request reduces this budget. SVG, HTML and PNG share one measurement per locale. Transcript-only requests do not consume a typography budget. Only PNG branch cache identity includes its effective raster plan; changing PNG settings does not invalidate an otherwise identical SVG, HTML or transcript branch."
    },
    "branchRun": {
      "type": "object",
      "properties": {
        "target_id": {
          "$ref": "#/$defs/targetId"
        },
        "outcome": {
          "enum": [
            "published",
            "blocked",
            "unavailable",
            "failed",
            "cancelled"
          ]
        },
        "cache": {
          "enum": [
            "source",
            "miss",
            "hit",
            "not_applicable"
          ]
        },
        "artifact_evidence_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^bundle:outputs/"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "target_id",
        "outcome",
        "cache",
        "artifact_evidence_index",
        "artifact_id",
        "locator",
        "diagnostics"
      ],
      "additionalProperties": false,
      "description": "Exact publication result for a planned target. All three artifact references are explicit null unless publication succeeds. The index addresses this run's artifact_manifest.artifacts; consumers must verify index/ID/locator/hash correspondence and output membership.",
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "published"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "cache": {
                "enum": [
                  "miss",
                  "hit"
                ]
              },
              "artifact_evidence_index": {
                "type": "integer",
                "minimum": 0
              },
              "artifact_id": {
                "$ref": "#/$defs/artifactId"
              },
              "locator": {
                "type": "string",
                "pattern": "^bundle:outputs/"
              }
            }
          },
          "else": {
            "properties": {
              "cache": {
                "const": "not_applicable"
              },
              "artifact_evidence_index": {
                "type": "null"
              },
              "artifact_id": {
                "type": "null"
              },
              "locator": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "renderflow.composition-run/v3"
        },
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "state": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "cancelled"
          ]
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "artifact_manifest": {
          "$ref": "renderflow-run-v1.schema.json#/$defs/artifact_manifest"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 576,
          "items": {
            "$ref": "#/$defs/branchRun"
          }
        },
        "runtime_qualified": {
          "const": false
        },
        "review_required": {
          "const": true
        },
        "visual_determinism_qualified": {
          "const": false
        }
      },
      "required": [
        "schema",
        "run_id",
        "state",
        "plan_sha256",
        "plan",
        "artifact_manifest",
        "branches",
        "runtime_qualified",
        "review_required",
        "visual_determinism_qualified"
      ],
      "additionalProperties": false,
      "description": "Receipt written after scoped composition publication. Complete means every selected output was published, not visually qualified or creatively approved. Run and embedded artifact-manifest IDs must match; plan_sha256 commits the retained pretty-serialized composition-plan.json bytes including trailing newline. Early I/O failure can leave no receipt. Terminal artifact metadata under renderflow.composition records typography.report_sha256 and provider identity; report_sha256 commits the compact JSON serialization of the corresponding embedded branch typography report. A deserialized report lacks the private geometry needed for execution; the public executor always derives a new plan from immutable captured inputs. PNG terminal metadata under renderflow.composition.raster retains the complete small raster plan. Successful publication means the bounded decoded output matched that plan, not that visual appearance, print fitness or cross-platform reproducibility has been qualified."
    },
    "typographyBounds": {
      "type": "object",
      "properties": {
        "x_min": {
          "type": "number"
        },
        "y_min": {
          "type": "number"
        },
        "x_max": {
          "type": "number"
        },
        "y_max": {
          "type": "number"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "additionalProperties": false,
      "description": "Conservative control-point hull in page points, not exact curve extrema or rasterized ink. Consumers must retain the provider profile and must not relabel this bound as pixel coverage."
    },
    "typographyFont": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "ttf",
            "otf"
          ]
        },
        "digest": {
          "type": "object",
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        "fallback_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "asset_id",
        "family",
        "format",
        "digest",
        "fallback_index"
      ],
      "additionalProperties": false,
      "description": "Exact captured static font selected for the whole text layer after authored fallback candidates are examined. A selection is not a font-license opinion or visual approval."
    },
    "typographyRejectedCandidate": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "fallback_index": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "asset_id",
        "fallback_index",
        "reason"
      ],
      "additionalProperties": false
    },
    "typographyGlyph": {
      "type": "object",
      "properties": {
        "glyph_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cluster_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "x_pt": {
          "type": "number"
        },
        "y_pt": {
          "type": "number"
        },
        "x_advance_pt": {
          "type": "number"
        },
        "y_advance_pt": {
          "type": "number"
        },
        "conservative_outline_bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/typographyBounds"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "glyph_id",
        "cluster_utf8",
        "x_pt",
        "y_pt",
        "x_advance_pt",
        "y_advance_pt",
        "conservative_outline_bounds"
      ],
      "additionalProperties": false,
      "description": "Shaped glyph identity, absolute UTF-8 byte cluster in the complete layer text, page-point position, advances and conservative outline bounds. Null bounds can represent glyphs without a drawn outline such as spaces."
    },
    "typographyLine": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "source_byte_start": {
          "type": "integer",
          "minimum": 0
        },
        "source_byte_end": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_y_pt": {
          "type": "number"
        },
        "origin_x_pt": {
          "type": "number"
        },
        "advance_pt": {
          "type": "number"
        },
        "conservative_outline_bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/typographyBounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "glyphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typographyGlyph"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "index",
        "source_byte_start",
        "source_byte_end",
        "baseline_y_pt",
        "origin_x_pt",
        "advance_pt",
        "conservative_outline_bounds",
        "glyphs"
      ],
      "additionalProperties": false,
      "description": "One explicit authored line. No automatic line wrapping, shrinking, truncation or translation is performed. Source byte ranges and clusters must be interpreted against the exact captured locale content."
    },
    "typographyLayer": {
      "type": "object",
      "properties": {
        "layer_id": {
          "type": "string",
          "minLength": 1
        },
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "body",
            "heading",
            "display",
            "monospace",
            "caption",
            "math"
          ]
        },
        "font_size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "selected_font": {
          "anyOf": [
            {
              "$ref": "#/$defs/typographyFont"
            },
            {
              "type": "null"
            }
          ]
        },
        "rejected_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typographyRejectedCandidate"
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typographyLine"
          },
          "maxItems": 256
        },
        "outline_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "layer_id",
        "content_id",
        "role",
        "font_size_pt",
        "selected_font",
        "rejected_candidates",
        "lines",
        "outline_digest"
      ],
      "additionalProperties": false,
      "description": "Per-layer measurement. outline_digest is the lowercase SHA-256 of compact JSON for the ordered private PositionedOutline array (glyph_id, path, x_pt, y_pt, scale). Paths use font units with an upward y axis; position and scale map them to page points. Glyphs with no drawn outline are omitted from that array; an empty array still has a digest. Raw path commands are absent from serialized plans. Failed/blocked layers can have null font or outline references; diagnostics explain the result."
    },
    "typographyReport": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "renderflow.composition-typography/v1"
        },
        "provider_profile": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typographyLayer"
          },
          "maxItems": 256
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "runtime_qualified": {
          "const": false
        }
      },
      "required": [
        "schema",
        "provider_profile",
        "locale",
        "layers",
        "diagnostics",
        "runtime_qualified"
      ],
      "additionalProperties": false,
      "description": "Measured evidence for the static Latin outline provider. Provider profile pins implementation versions and layout policies. Per-locale limits are 4096 referenced text code points, 4096 glyphs, 256 authored lines, 4 MiB private outline path bytes and 2 MiB compact report bytes. A visual plan first caps referenced text at 16384 code points across selected known locales, then caps distinct-locale compact reports and private outline paths at 16 MiB each before retaining branches. Cross-record totals and byte limits are enforced by the implementation rather than this schema. No executable qualification or creative approval is implied."
    },
    "rasterSettings": {
      "type": "object",
      "properties": {
        "dpi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "background": {
          "type": "string"
        }
      },
      "required": [
        "dpi",
        "background"
      ],
      "additionalProperties": false,
      "description": "Requested PNG-only settings. Omission of the request's raster object selects 144 DPI and a transparent background. The request preserves invalid values for blocked-branch diagnostics; successful raster plans require 36 through 600 DPI and transparent or a six-digit #RRGGBB background. Other output formats ignore these settings.",
      "default": {
        "dpi": 144,
        "background": "transparent"
      }
    },
    "effectiveRasterSettings": {
      "type": "object",
      "properties": {
        "dpi": {
          "type": "integer",
          "minimum": 36,
          "maximum": 600
        },
        "background": {
          "type": "string",
          "pattern": "^(transparent|#[0-9a-f]{6})$"
        }
      },
      "required": [
        "dpi",
        "background"
      ],
      "additionalProperties": false,
      "description": "Validated PNG-only settings; hexadecimal background colors are normalized to lowercase before cache identity is derived."
    },
    "rasterPlan": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "renderflow.composition-raster/v1"
        },
        "provider_profile": {
          "type": "string",
