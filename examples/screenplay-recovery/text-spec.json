{
  "schema": "renderflow/v2",
  "sources": [
    {
      "id": "source.screenplay-text",
      "path": "./scene.txt",
      "format": "text"
    }
  ],
  "targets": {
    "exact": [
      { "id": "target.recovered-canonical", "format": "screenplay-json" },
      { "id": "target.recovered-fountain", "format": "fountain" },
      { "id": "target.recovered-fdx", "format": "fdx" }
    ]
  },
  "execution": {
    "screenplay_recovery": {
      "allow_unqualified": true,
      "limits": {
        "max_input_bytes": 8388608,
        "max_pages": 100,
        "max_page_text_bytes": 262144,
        "max_total_text_bytes": 2097152,
        "max_raster_side": 3000,
        "timeout_seconds": 300
      }
    },
    "network": "deny",
    "ai": "deny"
  },
  "output": {
    "bundle_root": "./recovered-output",
    "naming_template": "{source.id}/{target.id}.{ext}",
    "collision": "error"
  }
}
