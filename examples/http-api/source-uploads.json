{
  "schema_version": "renderflow.http-service/v1",
  "bind": "127.0.0.1:8787",
  "http": {},
  "service": {
    "schema_version": "renderflow.api-service/v1",
    "workspace_parent": "/tmp",
    "pipelines": [
      {
        "id": "manual-lyrics",
        "profile": "manual_lyrics",
        "root": "../lyrics",
        "config": "renderflow.yaml",
        "files": [
          "renderflow.yaml",
          "manual.srt"
        ],
        "allow_source_uploads": true
      },
      {
        "id": "timed-text",
        "profile": "timed_text",
        "root": "../creative-forest",
        "config": "service-timed-text.json",
        "files": [
          "service-timed-text.json",
          "sources/captions.srt"
        ],
        "allow_source_uploads": true
      },
      {
        "id": "fountain-body",
        "profile": "fountain_body",
        "root": "../creative-forest",
        "config": "service-fountain.json",
        "files": [
          "service-fountain.json",
          "sources/original.fountain"
        ],
        "allow_source_uploads": true
      }
    ],
    "limits": {
      "upload_count": 16,
      "upload_bytes": 8388608,
      "all_upload_bytes": 33554432,
      "upload_retention_seconds": 900
    }
  }
}
