{
  "openapi": "3.1.0",
  "info": {
    "title": "Renderflow bounded local API",
    "version": "1.1.0-draft",
    "description": "Authored, unqualified #420 local adapter. Registered composition/manual-lyrics/timed-text/Fountain-body profiles use built-ins; editorial requires explicit operator local-process permission for Pandoc/Tectonic. Loopback, bearer, finite captured packages and process-local jobs. API envelopes wrap unchanged SDK objects. No upload/config/provider selection is accepted from clients; no runtime/schema/provider/release qualification is claimed."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "security": [
    {
      "localBearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "description": "Process liveness only. Host and origin gates still apply; no provider probing.",
        "responses": {
          "200": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthEnvelope"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "description": "Configured admission and shutdown status; native providers/output/runtime are not qualified.",
        "responses": {
          "200": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyEnvelope"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "description": "Service has stopped accepting jobs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "description": "This maintained OpenAPI envelope document; native SDK model fields remain owned by core.",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/pipelines": {
      "get": {
        "operationId": "pipelines",
        "description": "Registered package IDs and captured byte identities; no operator host-root paths or source upload.",
        "responses": {
          "200": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelinesEnvelope"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "capabilities",
        "description": "Finite profile policy inventory; graph/composition selection and runtime evidence remain SDK-owned. Each registered pipeline declares its profile and whether local processes were explicitly permitted.",
        "responses": {
          "200": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesEnvelope"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/formats": {
      "get": {
        "operationId": "formats",
        "description": "Finite profile policy inventory; graph/composition selection and runtime evidence remain SDK-owned. Each registered pipeline declares its profile and whether local processes were explicitly permitted.",
        "responses": {
          "200": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryEnvelope"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/transforms": {
      "get": {
        "operationId": "transforms",
        "description": "Finite profile policy inventory; graph/composition selection and runtime evidence remain SDK-owned. Each registered pipeline declares its profile and whether local processes were explicitly permitted.",
        "responses": {
          "200": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryEnvelope"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/inspect": {
      "post": {
        "operationId": "inspect",
        "description": "Queue inspect over one captured registered package. Poll Location; no synchronous render or client-provided config/path.",
        "responses": {
          "202": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Job status path"
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          }
        }
      }
    },
    "/v1/plan": {
      "post": {
        "operationId": "plan",
        "description": "Queue plan over one captured registered package. Poll Location; no synchronous render or client-provided config/path.",
        "responses": {
          "202": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Job status path"
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          }
        }
      }
    },
    "/v1/execute": {
      "post": {
        "operationId": "execute",
        "description": "Queue execute over one captured registered package. Poll Location; no synchronous render or client-provided config/path.",
        "responses": {
          "202": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Job status path"
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "operationId": "job",
        "description": "Current service state and unchanged bounded native result. Partial/failure remain explicit; cancellation intent is separate.",
        "responses": {
          "200": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^job-[0-9a-f]{64}$"
            }
          }
        ]
      },
      "delete": {
        "operationId": "cancel",
        "description": "Request SDK cancellation. Worker slot and workspace remain held until native return; terminal jobs retain actual state.",
        "responses": {
          "202": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          },
          "200": {
            "description": "The job is already terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnvelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^job-[0-9a-f]{64}$"
            }
          }
        ]
      }
    },
    "/v1/jobs/{job_id}/artifacts": {
      "get": {
        "operationId": "artifacts",
        "description": "Actual native publication joins only. File bytes are re-observed on download; this list grants no approval.",
        "responses": {
          "200": {
            "description": "Structured response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactsEnvelope"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^job-[0-9a-f]{64}$"
            }
          }
        ]
      }
    },
    "/v1/jobs/{job_id}/retention": {
      "delete": {
        "operationId": "forget",
        "description": "Forget a terminal job and release retained private data; active jobs return 409.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^job-[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Retained terminal data released"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/jobs/{job_id}/artifacts/{artifact_id}": {
      "get": {
        "operationId": "download",
        "description": "Native confined bytes are copied into bounded private temporary storage and verified before success headers. Fixed Content-Length, observed SHA-256 and ETag identify the full response. Interrupted delivery closes the connection without a JSON suffix; clients must check length/hash. No Range or resumable/conditional transfer is supported.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^job-[0-9a-f]{64}$"
            }
          },
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^artifact-[0-9]{1,6}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observed bytes; native validation/review/fidelity is preserved without promotion",
            "headers": {
              "X-Content-SHA256": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "Exact verified snapshot byte length"
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong sha256-prefixed observed snapshot digest"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          },
          "416": {
            "description": "Partial ranges are refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Snapshot count/byte/storage capacity or shutdown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream one complete verified artifact snapshot"
      },
      "head": {
        "operationId": "download",
        "description": "Native confined bytes are copied into bounded private temporary storage and verified before success headers. Fixed Content-Length, observed SHA-256 and ETag identify the full response. Interrupted delivery closes the connection without a JSON suffix; clients must check length/hash. No Range or resumable/conditional transfer is supported.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^job-[0-9a-f]{64}$"
            }
          },
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^artifact-[0-9]{1,6}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observed bytes; native validation/review/fidelity is preserved without promotion",
            "headers": {
              "X-Content-SHA256": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "Exact verified snapshot byte length"
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong sha256-prefixed observed snapshot digest"
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          },
          "416": {
            "description": "Partial ranges are refused"
          },
          "503": {
            "description": "Snapshot count/byte/storage capacity or shutdown"
          }
        },
        "summary": "Verify the full artifact snapshot and return headers without body"
      }
    },
    "/v1/jobs/{job_id}/events": {
      "get": {
        "operationId": "events",
        "description": "Finite SSE replay of retained SDK progress events, followed by a job metadata event. Connection closes; reconnect with after OR Last-Event-ID. IDs/gap/drop metadata make eviction explicit. No fabricated percentages or long-lived push stream.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^job-[0-9a-f]{64}$"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Exclusive cursor; mutually exclusive with Last-Event-ID."
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "event: progress carries ProgressEvent; event: job carries current state/last_event_id/dropped_events/cursor_gap.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/pipelines/{pipeline_id}/uploads": {
      "post": {
        "summary": "Capture a bounded immutable source for an operator-enabled built-in text pipeline",
        "description": "One raw source only. No filenames, paths, config, assets or effect/profile choices. Upload alone starts no job or model and inherits no review. Body admission follows authentication and operator permission. No multipart/chunked/compressed framing.",
        "parameters": [
          {
            "name": "pipeline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            }
          },
          {
            "name": "X-Content-SHA256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          {
            "name": "Content-Length",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable source captured; Location identifies metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Malformed digest/framing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Uploads disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown pipeline",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Body/source limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Wrong content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Digest mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Retained upload capacity or shutdown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/uploads/{upload_id}": {
      "get": {
        "summary": "Read immutable upload metadata before expiry",
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^upload-[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadata only; no source bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Forget an upload only after all referencing jobs are forgotten",
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^upload-[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Unused upload removed"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Retained job still references upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/schemas/renderflow-sdk-api-v1.schema.json": {
      "get": {
        "summary": "Read the self-contained core-owned SDK result/progress schema projection",
        "description": "Read-only embedded schema assembly; no model, provider or source operation. Imported core run/intake declarations remain the source, with all served references local to this document.",
        "responses": {
          "200": {
            "description": "Raw JSON Schema document, without the ordinary data envelope",
            "content": {
              "application/schema+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque 32\u2013256 ASCII non-whitespace bytes",
        "description": "Single trusted local operator scope. Shipped executable reads RENDERFLOW_API_TOKEN; token is never logged."
      }
    },
    "responses": {
      "Error": {
        "description": "Structured failure: 400/401/403/404/408/409/411/413/415/417/422/431/500/503 as applicable. Saturated socket admission closes before parsing. Native failed jobs remain 200 status resources with failed state.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pipeline_id"
        ],
        "properties": {
          "pipeline_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "dry_run": {
            "type": "boolean",
            "default": false,
            "description": "Only execute admits true; it preserves native planned state and publishes no artifacts."
          },
