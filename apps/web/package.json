{
	"name": "@egohygiene/renderflow-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "tsc -b && vite build && node ./scripts/postbuild.mjs",
		"preview": "vite preview --host 0.0.0.0",
		"format": "biome format .",
		"format:write": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm format && pnpm lint && pnpm test && pnpm build && node ./scripts/verify-build.mjs"
	},
	"dependencies": {
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router-dom": "7.18.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@types/node": "24.13.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.5",
		"axe-core": "4.12.1",
		"jsdom": "30.0.1",
		"typescript": "7.0.2",
		"vite": "8.2.0",
		"vitest": "4.1.10"
	}
}
